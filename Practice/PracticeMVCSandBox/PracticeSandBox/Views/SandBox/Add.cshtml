@model PracticeSandBox.Models.ProductFormViewModel

@{
    ViewData["Title"] = "Add Product";
}

<div style="font-family: Arial, sans-serif; margin: 40px;">
    <h2>Add New Product</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background-color: green; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px; max-width: 400px; border: 1px solid #c3e6cb;">
            <strong>Success!</strong> @Model.SuccessMessage
        </div>
    }

    <div asp-validation-summary="All" style="color:red"></div>

    <form asp-action="Add" method="post">
        <div>
            <label>Name:</label>
            <input asp-for="ProductName"/>
            <span asp-validation-for="ProductName" style="color:blue"></span>
        </div>
        <div>
            <label>Price:</label>
            <input asp-for="Price"/>
            <span asp-validation-for="Price" style="color:blue"></span>
        </div>
        <div>
            <label>StockLevel:</label>
            <input asp-for="StockLevel"/>
            <span asp-validation-for="StockLevel" style="color:blue"></span>
        </div>
        <button type="submit">Add</button>
    </form>