@model PracticeSandBox.Models.ProductFormViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">
    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-header">
            <h3 class="mb-0">Edit Product</h3>
        </div>

        <div class="card-body">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <form asp-action="Edit" method="post">

                @* id field is hidden *@
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="ProductName"
                           class="form-label">Product Name</label>
                    <input asp-for="ProductName"
                           class="form-control" />
                    <span asp-validation-for="ProductName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price"
                           class="form-label">Price</label>
                    <input asp-for="Price"
                           class="form-control" />
                    <span asp-validation-for="Price"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockLevel"
                           class="form-label">Stock Level</label>
                    <input asp-for="StockLevel"
                           class="form-control" />
                    <span asp-validation-for="StockLevel"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>
        </div>
    </div>
</div>
