@model PracticeSandBox.Models.ProductListViewModel

@{
    ViewData["Title"] = "Product Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Product Management</h2>
            <p class="text-muted mb-0">
                Manage your products and inventory.
            </p>
        </div>

        <a asp-action="Add" class="btn btn-primary">
            + Add Product
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Search -->
            <form asp-action="Index" method="get" class="mb-4">
                <div class="input-group">
                    <input type="text"
                           name="searchString"
                           value="@Model.SearchString"
                           class="form-control"
                           placeholder="Search products by name..." />

                    <button type="submit" class="btn btn-primary">
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>


            @if (!Model.Products.Any())
            {
                <!-- Empty state -->
                <div class="text-center py-5">
                    <h5>No products found</h5>
                    <p class="text-muted">
                        No products match your search, or your inventory is empty.
                    </p>
                    <a asp-action="Add" class="btn btn-primary">
                        Add Product
                    </a>
                </div>
            }
            else
            {

                <!-- Products table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>

                                <th>
                                    <a asp-action="Index"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-sortOrder="@Model.NameSortParam"
                                       class="text-decoration-none text-dark">
                                        Product Name
                                        @if (Model.SortOrder?.ToString() == "name_asc")
                                        {
                                            <span>↑</span>
                                        }
                                        else if (Model.SortOrder?.ToString() == "name_desc")
                                        {
                                            <span>↓</span>
                                        }
                                        else
                                        {
                                            <span>↕</span>
                                        }
                                    </a>
                                </th>

                                <th>
                                    <a asp-action="Index"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-sortOrder="@Model.PriceSortParam"
                                       class="text-decoration-none text-dark">
                                        Price
                                        @if (Model.SortOrder?.ToString() == "price_asc")
                                        {
                                            <span>↑</span>
                                        }
                                        else if (Model.SortOrder?.ToString() == "price_desc")
                                        {
                                            <span>↓</span>
                                        }
                                        else
                                        {
                                            <span>↕</span>
                                        }
                                    </a>
                                </th>
                               
                                <th>Stock</th>
                                <th style="min-width: 280px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.Id</td>

                                    <td class="fw-semibold">
                                        @product.ProductName
                                    </td>

                                    <td>Rs. @product.Price.ToString("N2")</td>

                                    <td>
                                        @if (product.StockLevel > 0)
                                        {
                                            <span class="badge bg-success">
                                                @product.StockLevel in stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Out of stock
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-info">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Product pages" class="mt-4">
                        <ul class="pagination justify-content-center">

                            <!-- Previous -->
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    Previous
                                </a>
                            </li>

                            <!-- Page numbers -->
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-sortOrder="@Model.SortOrder">
                                        @i
                                    </a>
                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    Next
                                </a>
                            </li>

                        </ul>
                    </nav>
                }

                <p class="text-muted small text-center">
                    Page @Model.CurrentPage of @Model.TotalPages
                    &mdash;
                    @Model.TotalProducts products found
                </p>
            }

        </div>
    </div>

    <div class="mt-3 text-muted small">
        Total products: @(Model?.TotalProducts ?? 0)
    </div>

</div>