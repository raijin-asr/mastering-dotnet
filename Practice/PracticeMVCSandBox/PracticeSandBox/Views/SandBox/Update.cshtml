@model PracticeSandBox.Models.ProductUpdateViewModel

@{
    ViewData["Title"] = "Form Submission Sandbox";
}

<div style="font-family: Arial, sans-serif; margin: 40px;">
    <h2>[HttpPost] Form Sandbox Test</h2>
    <p>Testing user input sent back to the Controller.</p>
    <hr />

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="background-color: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px; max-width: 400px; border: 1px solid #c3e6cb;">
            <strong>Success!</strong> @Model.SuccessMessage
        </div>
    }

    <div asp-validation-summary="All" style="color:red"></div>

    <form asp-action="Update" method="post">
        <div>
            <label>Name:</label>
            <input asp-for="ProductName"/>
            <span asp-validation-for="ProductName" style="color:blue"></span>
        </div>
        <div>
            <label>Price:</label>
            <input asp-for="Price"/>
            <span asp-validation-for="Price" style="color:blue"></span>
        </div>
        <div>
            <label>StockLevel:</label>
            <input asp-for="StockLevel"/>
            <span asp-validation-for="StockLevel" style="color:blue"></span>
        </div>
        <button type="submit">
            Update
        </button>
    </form>