@model PracticeSandBox.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-header bg-light">
            <h3 class="mb-0">Product Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-4">Product ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Product Name</dt>
                <dd class="col-sm-8">@Model.ProductName</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">
                    Rs. @Model.Price.ToString("N2")
                </dd>

                <dt class="col-sm-4">Stock Level</dt>
                <dd class="col-sm-8">@Model.StockLevel</dd>
            </dl>

            <hr />

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Products List
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit Product
            </a>

        </div>
    </div>

</div>
